# Edge Function secrets. Local: copy to supabase/functions/.env (gitignored) for `supabase functions serve`.
# Remote: `supabase secrets set --env-file supabase/functions/.env` (or one by one). Never commit real values.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.

# --- AI (tech-stack.md "Chiến lược AI", launch-plan.md §4)
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL_FAST=gemini-flash-latest
# Optional stronger model, used only for "Phân tích lại" (reanalyze=true)
AI_MODEL_STRONG=
AI_DAILY_PHOTO_LIMIT=15
AI_DAILY_TEXT_LIMIT=50
AI_TIMEOUT_MS=45000
# Cost estimate (USD per 1M tokens) for ai_requests.cost_usd
AI_PRICE_INPUT_PER_MTOK=0.5
AI_PRICE_OUTPUT_PER_MTOK=3
# AI_PRICES_JSON={"gemini-2.5-pro":{"in":1.25,"out":10}}

# --- Cron → close-day / weekly-review (same value as the vault secret `cron_secret`; ≥ 32 random chars)
CRON_SECRET=
