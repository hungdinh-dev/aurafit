{
  "expo": {
    "name": "AuraFit",
    "slug": "aurafit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aurafit",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "com.aurafit.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "vi"
      }
    },
    "android": {
      "package": "com.aurafit.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "locales": {
      "vi": { "CFBundleDisplayName": "AuraFit" },
      "en": { "CFBundleDisplayName": "AuraFit" }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#4BE3A7"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AuraFit dùng camera để chụp món ăn và quét mã vạch.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AuraFit cần quyền xem ảnh để bạn chọn ảnh món ăn.",
          "cameraPermission": "AuraFit dùng camera để chụp món ăn.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
