# Copy to apps/mobile/.env (git-ignored). Only EXPO_PUBLIC_* values are bundled into the app.
# The anon/publishable key is safe in the client – RLS protects the data.
# The app starts without these (a dev warning is shown and sign-in is disabled).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Google OAuth client IDs (Google Cloud Console) – configured in Supabase Auth > Google.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
