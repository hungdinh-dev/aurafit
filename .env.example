# Copy to apps/mobile/.env (never commit the real file).
# Public values only – the anon/publishable key is safe in the app, RLS protects data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Google OAuth client IDs (Google Cloud Console)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Server-side secrets: set with `supabase secrets set`, NOT in the app.
# GEMINI_API_KEY=
# AI_PROVIDER=gemini
# AI_MODEL_FAST=gemini-flash-latest
# AI_DAILY_PHOTO_LIMIT=15
